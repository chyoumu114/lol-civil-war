# 部署配置（复制为 deploy/.env 后填写；.env 已被 .gitignore 忽略）
#
# 群白名单：逗号分隔，留空会拒绝所有群。
LCW_ALLOWED_GROUPS=123456789

# 对外访问地址：用于 QQ 回调与 Cookie Secure 判定，必须与实际访问地址一致。
LCW_BASE_URL=http://localhost:18020

# 开发登录：仅本地调试开启，生产必须 false。
# 生产形态（https 或非回环地址）开启且未设 LCW_DEV_MODE=true 时，服务会拒绝启动。
LCW_DEV_LOGIN=false

# 显式声明本地/内网调试环境：放宽“数据库口令不能为空”等生产校验。
# 生产环境必须保持 false。
LCW_DEV_MODE=false

# QQ 互联（https://connect.qq.com/）网站应用凭据。
# 可选：留空时只提供邮箱注册/登录，不显示 QQ 快捷登录。
LCW_QQ_APP_ID=
LCW_QQ_APP_KEY=
# 留空时自动使用 LCW_BASE_URL + /auth/qq/callback
LCW_QQ_REDIRECT_URI=

# 会话空闲有效期与绝对寿命（小时）。绝对寿命到期后必须重新登录。
LCW_SESSION_TTL_HOURS=72
LCW_SESSION_MAX_HOURS=336

# ROFL 录像上传上限（KB）与解析并发数。
LCW_ROFL_MAX_KB=65536
LCW_UPLOAD_CONCURRENCY=2

# DataDragon 英雄数据版本；留空则自动探测最新版本。
# 更新英雄库时由 make champions CHAMPION_VERSION=x.y.z 写入 library.json。
LCW_DDRAGON_VERSION=16.20.1

# 本地英雄头像目录；容器内默认 /data/champions。
LCW_CHAMPION_ICON_DIR=

# Cookie Secure：auto / true / false；HTTPS 站点用 auto 即可。
LCW_COOKIE_SECURE=auto

# 反向代理：默认不信任 X-Forwarded-For。
# 只填实际网关地址（尽量 /32）。不要使用 172.16.0.0/12 这类大网段，
# 否则同网段任何主机都能伪造 XFF 绕过限流。
# 查询容器看到的网关：docker network inspect <网络名> --format '{{.IPAM.Config}}'
LCW_TRUST_PROXY=false
# LCW_TRUSTED_PROXIES=172.20.0.1/32

# 启动时是否自动建表/升级。生产可设为 false，运行时账号仅需 DML 权限，
# 升级改为执行 `lol-civil-war migrate`（或 docker compose exec app ... migrate）。
LCW_MIGRATE_ON_START=true

# MySQL：compose 会用这些变量同时初始化数据库和应用的连接参数。
MYSQL_DATABASE=lol_civil_war
MYSQL_USER=lcw
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# 如果服务器拉取 Docker Hub 很慢，可换成私有仓库里的 MySQL 镜像。
# MYSQL_IMAGE=mysql:8.4

# 应用配置（compose 使用）。
LCW_IMAGE=lol-civil-war:latest
LCW_BIND=127.0.0.1:18020
LCW_CONTAINER_NAME=lol-civil-war
LCW_VOLUME=lol-civil-war-data
LCW_MYSQL_VOLUME=lol-civil-war-mysql-data
MYSQL_CONTAINER_NAME=lol-civil-war-mysql

# 从源码构建时可选：国内网络可开启加速
# DOCKER_GOPROXY=https://goproxy.cn,direct
# DOCKER_NPM_REGISTRY=https://registry.npmmirror.com

# 本地不使用 compose、直接 go run 时，取消下面几行注释：
# LCW_DB_HOST=127.0.0.1
# LCW_DB_PORT=3306
# LCW_DB_USER=lcw
# LCW_DB_PASSWORD=change-me
# LCW_DB_NAME=lol_civil_war
